FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_TICKETPILOT_AUTH_MODE=bearer
ENV VITE_TICKETPILOT_AUTH_MODE=$VITE_TICKETPILOT_AUTH_MODE
RUN npm run build

FROM nginx:1.29-alpine

COPY docker/nginx.ticketpilot.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
